# Kora's toolbar on this staging site. In Kora: the « Lien » deliverable whose address is this site,
# « Partager la revue » → « Script de recette »:
#   NEXT_PUBLIC_KORA_URL  = the start of src, without /kora-toolbar.js (e.g. https://kora.example.com)
#   NEXT_PUBLIC_KORA_SITE = the value of data-site
# Neither is a secret: the line is in the page for every visitor. Empty, the site runs without the toolbar.
NEXT_PUBLIC_KORA_URL=
NEXT_PUBLIC_KORA_SITE=
